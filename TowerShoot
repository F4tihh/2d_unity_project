using UnityEngine;

public class TowerShoot : MonoBehaviour
{
    public GameObject bulletPrefab;
    public float shootInterval = 1.5f;

    void Start()
    {
        InvokeRepeating("Shoot", 1f, shootInterval);
    }

    void Shoot()
    {
        Instantiate(bulletPrefab, transform.position, Quaternion.identity);
    }
}
